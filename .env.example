# Local Node defaults. Docker Compose overrides HOST and DATA_FILE inside the container.
HOST=127.0.0.1
PORT=4173
DATA_FILE=data/wuyin.sqlite

# Server-side only. Leave empty to keep raw clips available without Lingxi transcription/TTS.
LINGXI_API_KEY=

# JSON array of self-managed STUN/TURN entries. Keep TURN credentials out of Git.
ICE_SERVERS=[]

# Exact browser origin, including scheme and port.
PUBLIC_ORIGIN=http://127.0.0.1:4173
COOKIE_SECURE=false
