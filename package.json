{
  "name": "wuyin-werewolf",
  "version": "0.1.0",
  "private": true,
  "description": "雾隐镇：语音证据与可验证复盘狼人杀",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node -e \"require('./server').start()\"",
    "test": "node --test --test-concurrency=1 test/*/*.test.js",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage', {recursive:true})\" && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/coverage-inventory.cjs' --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=95 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*/*.test.js && node scripts/coverage-inventory.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "v8-to-istanbul": "^9.3.0"
  }
}
